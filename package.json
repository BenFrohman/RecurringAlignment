{
  "name": "recurring-alignment-monorepo",
  "private": true,
  "version": "0.2.1",
  "description": "Keep AI-assistant conversations on track: detect drift and inject compact realignment prompts.",
  "license": "MIT",
  "author": "Benjamin Frohman <frohmanbenjamin@gmail.com>",
  "type": "module",
  "workspaces": [
    "packages/core",
    "packages/judges",
    "packages/middleware",
    "packages/replay",
    "packages/cli"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "rm -rf packages/*/dist packages/*/tsconfig.tsbuildinfo",
    "typecheck": "tsc -b",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "npm run build && node --test packages/*/dist/test/*.test.js",
    "coverage": "npm run build && node --test --experimental-test-coverage --test-coverage-exclude=\"**/dist/test/**\" --test-coverage-lines=90 --test-coverage-branches=80 --test-coverage-functions=90 packages/*/dist/test/*.test.js",
    "demo": "npm run build && node packages/cli/dist/src/bin.js check examples/transcript.json; node examples/middleware-demo.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.3.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BenFrohman/RecurringAlignment.git"
  },
  "homepage": "https://github.com/BenFrohman/RecurringAlignment#readme",
  "keywords": [
    "llm",
    "ai-assistant",
    "alignment",
    "drift-detection",
    "prompt-engineering",
    "context-management",
    "tf-idf"
  ]
}
